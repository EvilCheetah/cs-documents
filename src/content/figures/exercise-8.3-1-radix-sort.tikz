\documentclass[border=15pt]{standalone}
\usepackage{tikz}
\usetikzlibrary{matrix, positioning, arrows.meta, backgrounds, calc}


\begin{document}

\begin{tikzpicture}[
    font=\Large\ttfamily,
    digit/.style={
        anchor=center,
        text height=1.5ex,
        text depth=0ex,
        inner sep=2pt,
        text width=1em,
        align=center
    },
    highlight/.style={
        fill=orange!25,
        draw=orange!70,
        line width=0.6pt
    },
    arrow/.style={
        -{Stealth[length=12pt, width=10pt]}, 
        color=cyan!90!blue,
        line width=1.2pt
    }
]


% Define layers to put the highlight boxes behind the text
\pgfdeclarelayer{background}
\pgfsetlayers{background,main}


% Input
\matrix (M1) [matrix of nodes, nodes={digit}, column sep=0.1em, row sep=0.2em] {
C & O & W \\
D & O & G \\
S & E & A \\
R & U & G \\
R & O & W \\
M & O & B \\
B & O & X \\
T & A & B \\
B & A & R \\
E & A & R \\
T & A & R \\
D & I & G \\
B & I & G \\
T & E & A \\
N & O & W \\
F & O & X \\
};

% Sort by least significant letter (3rd)
\matrix (M2) [matrix of nodes, nodes={digit}, column sep=0.1em, row sep=0.2em, right=1.2cm of M1] {
S & E & A \\
T & E & A \\
M & O & B \\
T & A & B \\
D & O & G \\
R & U & G \\
D & I & G \\
B & I & G \\
B & A & R \\
E & A & R \\
T & A & R \\
C & O & W \\
R & O & W \\
N & O & W \\
B & O & X \\
F & O & X \\
};

% Sort by middle letter (2nd)
\matrix (M3) [matrix of nodes, nodes={digit}, column sep=0.1em, row sep=0.2em, right=1.2cm of M2] {
T & A & B \\
B & A & R \\
E & A & R \\
T & A & R \\
S & E & A \\
T & E & A \\
D & I & G \\
B & I & G \\
M & O & B \\
D & O & G \\
C & O & W \\
R & O & W \\
N & O & W \\
B & O & X \\
F & O & X \\
R & U & G \\
};

% Sort by most significant letter (1st)
\matrix (M4) [matrix of nodes, nodes={digit}, column sep=0.1em, row sep=0.2em, right=1.2cm of M3] {
B & A & R \\
B & I & G \\
B & O & X \\
C & O & W \\
D & I & G \\
D & O & G \\
E & A & R \\
F & O & X \\
M & O & B \\
N & O & W \\
R & O & W \\
R & U & G \\
S & E & A \\
T & A & B \\
T & A & R \\
T & E & A \\
};

% ==== Background Highlight Boxes ====
\begin{pgfonlayer}{background}
    % Box for Sort by least significant letter (3rd)
    \filldraw[highlight] 
        ([yshift=0.6pt]M2-1-3.north west)
        rectangle
        ([yshift=2pt]M2-16-3.south east);

    % Box for Sort by middle letter (2nd)
    \filldraw[highlight] 
        ([yshift=0.6pt]M3-1-2.north west)
        rectangle
        ([yshift=2pt]M3-16-2.south east);

    % Box for Sort by most significant letter (1st)
    \filldraw[highlight] 
        ([yshift=0.6pt]M4-1-1.north west)
        rectangle
        ([yshift=2pt]M4-16-1.south east);
\end{pgfonlayer}


% Connecting Arrows
\draw [arrow] ([xshift=0.2cm]M1.east |- M1-8-2) -- ([xshift=-0.2cm]M2.west |- M2-8-2);
\draw [arrow] ([xshift=0.2cm]M2.east |- M2-8-2) -- ([xshift=-0.2cm]M3.west |- M3-8-2);
\draw [arrow] ([xshift=0.2cm]M3.east |- M3-8-2) -- ([xshift=-0.2cm]M4.west |- M4-8-2);

\end{tikzpicture}

\end{document}
